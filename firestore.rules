rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // An admin is anyone whose user id has a document in the "admins" collection.
    // Those documents can only be created by you, in the Firebase console.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Everyone can see products; only admins can change them.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Customers can place an order but never read, change or delete one.
    match /orders/{orderId} {
      allow create: if request.resource.data.keys().hasOnly(['customer', 'items', 'total', 'status', 'createdAt'])
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time
        && request.resource.data.total is number
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.customer.keys().hasOnly(['name', 'email', 'phone', 'address'])
        && request.resource.data.customer.name is string && request.resource.data.customer.name.size() <= 120
        && request.resource.data.customer.email is string && request.resource.data.customer.email.size() <= 200
        && request.resource.data.customer.phone is string && request.resource.data.customer.phone.size() <= 40
        && request.resource.data.customer.address is string && request.resource.data.customer.address.size() <= 500;
      allow read, update, delete: if isAdmin();
    }
  }
}
